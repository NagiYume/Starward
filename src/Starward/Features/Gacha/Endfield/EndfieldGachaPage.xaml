<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Gacha.Endfield.EndfieldGachaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.Gacha.Endfield"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <Image Width="28"
                   Height="28"
                   Source="ms-appx:///Assets/Image/icon_endfield.png" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="寻访记录" />
        </StackPanel>

        <StackPanel Margin="0,0,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <cwc:Segmented SelectedIndex="{x:Bind SelectedRecordTypeIndex, Mode=TwoWay}">
                <cwc:SegmentedItem Content="干员寻访" />
                <cwc:SegmentedItem Content="武器申领" />
            </cwc:Segmented>
            <ComboBox Width="190"
                      ItemsSource="{x:Bind Accounts}"
                      PlaceholderText="选择账号"
                      SelectedItem="{x:Bind SelectedAccount, Mode=TwoWay}" />
            <SplitButton Command="{x:Bind SyncGachaCommand}"
                         IsEnabled="{x:Bind IsSyncing, Converter={StaticResource BoolReversedConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="同步记录" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{x:Bind LoginAccountCommand}"
                                        Icon="Contact"
                                        Text="登录鹰角账号" />
                        <MenuFlyoutItem Command="{x:Bind InputLoginTokenCommand}"
                                        Icon="Permissions"
                                        Text="输入登录 Token" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{x:Bind SyncFromGameLogCommand}"
                                        Icon="OpenFile"
                                        Text="从游戏日志同步" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button Command="{x:Bind CancelSyncCommand}"
                    Content="取消"
                    Visibility="{x:Bind IsSyncing}" />
            <ProgressRing Width="18"
                          Height="18"
                          IsActive="{x:Bind IsSyncing}" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 Margin="20,4,20,10"
                 IsClosable="True"
                 IsOpen="{x:Bind IsStatusOpen, Mode=TwoWay}"
                 Message="{x:Bind StatusText}"
                 Severity="{x:Bind StatusSeverity}" />

        <ScrollViewer x:Name="ScrollViewer_GachaStats"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      SizeChanged="ScrollViewer_GachaStats_SizeChanged">
            <Grid Margin="20,0,20,16" Background="Transparent">
                <ItemsControl x:Name="ItemsControl_GachaStats" ItemsSource="{x:Bind GachaStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:EndfieldGachaPoolStats">
                            <local:EndfieldGachaStatsCard Loaded="GachaStatsCard_Loaded"
                                                           Unloaded="GachaStatsCard_Unloaded"
                                                           PoolStats="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind IsEmpty}">
            <FontIcon FontSize="42" Glyph="&#xF4A5;" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="暂无寻访记录" />
        </StackPanel>
    </Grid>
</sf:PageBase>
