<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Gacha.Endfield.EndfieldGachaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.Gacha.Endfield"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <Image Width="28"
                   Height="28"
                   Source="ms-appx:///Assets/Image/icon_endfield.png" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="寻访记录" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <ComboBox Width="190"
                      ItemsSource="{x:Bind Accounts}"
                      PlaceholderText="选择账号"
                      SelectedItem="{x:Bind SelectedAccount, Mode=TwoWay}" />
            <SplitButton Command="{x:Bind SyncGachaCommand}"
                         IsEnabled="{x:Bind IsSyncing, Converter={StaticResource BoolReversedConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="同步记录" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{x:Bind LoginAccountCommand}"
                                        Icon="Contact"
                                        Text="登录鹰角账号" />
                        <MenuFlyoutItem Command="{x:Bind InputLoginTokenCommand}"
                                        Icon="Permissions"
                                        Text="输入登录 Token" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{x:Bind SyncFromGameLogCommand}"
                                        Icon="OpenFile"
                                        Text="从游戏日志同步" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button Command="{x:Bind CancelSyncCommand}"
                    Content="取消"
                    Visibility="{x:Bind IsSyncing}" />
            <ProgressRing Width="18"
                          Height="18"
                          IsActive="{x:Bind IsSyncing}" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 Margin="20,4,20,10"
                 IsClosable="True"
                 IsOpen="{x:Bind IsStatusOpen, Mode=TwoWay}"
                 Message="{x:Bind StatusText}"
                 Severity="{x:Bind StatusSeverity}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Padding="20,16,16,20"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="记录类型" />
                <ComboBox Grid.Row="1"
                          Margin="0,8,0,20"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind SelectedRecordTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="干员寻访" />
                    <ComboBoxItem Content="武器申领" />
                </ComboBox>
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind PoolOptions}"
                          SelectedItem="{x:Bind SelectedPool, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EndfieldGachaPoolOption">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" Padding="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总次数" />
                            <TextBlock Margin="0,4,0,0" FontSize="24" Text="{x:Bind Stats.Total}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="六星数量" />
                            <TextBlock Margin="0,4,0,0" FontSize="24" Text="{x:Bind Stats.Count6}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="六星占比" />
                            <TextBlock Margin="0,4,0,0" FontSize="24" Text="{x:Bind Stats.SixRate}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3"
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前未出六星" />
                            <TextBlock Margin="0,4,0,0" FontSize="24" Text="{x:Bind Stats.PityText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="2,12,2,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind Stats.RaritySummary}" />

                <Grid Grid.Row="2" Margin="2,12,2,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="时间" />
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="名称" />
                    <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="稀有度" />
                    <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="寻访池" />
                    <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="垫抽" />
                    <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" />
                </Grid>

                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind DisplayItems}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EndfieldGachaItem">
                            <Grid MinHeight="42" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind TimeText}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind ItemName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind RarityText}" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind PoolName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind PityText}" />
                                <TextBlock Grid.Column="5"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Text="{x:Bind ExtraText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="{x:Bind IsEmpty}">
                    <FontIcon FontSize="42" Glyph="&#xF4A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="暂无寻访记录" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</sf:PageBase>
